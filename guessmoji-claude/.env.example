# Copy to .env.local and fill in. Never commit real values.

# Public base URL used in verification links. Required in production.
APP_URL=http://localhost:3000

# SQLite database file (default: ./data/guessmoji.db)
# DATABASE_PATH=./data/guessmoji.db

# SMTP for verification emails. If SMTP_HOST is unset in development,
# emails are printed to the server console instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="GuessMoji <you@example.com>"
