# Copy to .env.local and fill in. Never commit real values.

# Public base URL used in email links. Required in production.
# For the public demo, set it to your permanent ngrok domain, e.g. https://<name>.ngrok-free.dev
APP_URL=http://localhost:3000

# SQLite database file (default: ./data/guessmoji.db)
# DATABASE_PATH=./data/guessmoji.db

# SMTP for verification and password-reset emails. If SMTP_HOST is unset in
# development, emails are printed to the server console instead.
# Required in production. Gmail example below; SMTP_PASS is a 16-character
# Gmail *app password* (see README "Public demo link"), not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="GuessMoji <you@example.com>"
#
# Brevo alternative (free plan, no card):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
